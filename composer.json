{
    "name": "thumbrise/op-universal-schema",
    "description": "Operation Protocol Schema — PHP type definitions",
    "license": "Apache-2.0",
    "type": "library",
    "config": {
        "platform": {
            "php": "8.1.0"
        }
    },
    "autoload": {
        "psr-4": {
            "Thumbrise\\OP\\Universal\\Schema\\": "./src"
        }
    },
    "require": {
        "php": ">=8.1"
    },
    "scripts": {
        "test": "@php vendor/bin/phpunit --testdox --colors=always",
        "lint": [
            "@php vendor/bin/php-cs-fixer fix"
        ],
        "lint:ci": [
            "@php vendor/bin/php-cs-fixer check"
        ]
    },
    "require-dev": {
        "friendsofphp/php-cs-fixer": "^3",
        "phpunit/phpunit": "^10.5"
    }
}

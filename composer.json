{
    "name": "thumbrise/op-universal-schema",
    "description": "Operation Protocol Schema — PHP type definitions",
    "license": "Apache-2.0",
    "type": "library",
    "autoload": {
        "psr-4": {
            "Thumbrise\\OP\\Universal\\Schema\\": "./src"
        }
    },
    "require": {
        "php": ">=8.1"
    },
    "scripts": {
        "lint": [
            "@php vendor/bin/php-cs-fixer fix"
        ],
        "lint:ci": [
            "@php vendor/bin/php-cs-fixer check"
        ]
    },
    "require-dev": {
        "friendsofphp/php-cs-fixer": "^3"
    }
}
